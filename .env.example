# --- Envoi d'email du PDF (SMTP) ---
# À définir comme "Environment Variables" dans Vercel (Settings > Environment Variables).
#
# Office 365 refuse l'authentification par mot de passe (erreur 535 5.7.139)
# lorsque les paramètres de sécurité du tenant bloquent l'authentification
# héritée. On utilise donc un relais SMTP dédié (Brevo, gratuit 300 mails/jour).

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587

# Identifiants du relais SMTP (login Brevo + SMTP key)
SMTP_USER=
SMTP_PASS=

# Destinataire des contrats = archive/backup
NOTIFY_EMAIL=contenu@larosiere.net

# Expéditeur affiché (par défaut = SMTP_USER)
EMAIL_FROM=contenu@larosiere.net
