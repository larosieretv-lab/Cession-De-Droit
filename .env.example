# --- Envoi d'email du PDF (SMTP Outlook / Office 365) ---
# À définir comme "Environment Variables" dans Vercel (Settings > Environment Variables).
#
# Note Office 365 : si la validation en 2 étapes est active sur contenu@larosiere.net,
# créez un "mot de passe d'application" et utilisez-le comme SMTP_PASS.

SMTP_HOST=smtp.office365.com
SMTP_PORT=587

# Adresse expéditrice + identifiants (la boîte qui envoie)
SMTP_USER=contenu@larosiere.net
SMTP_PASS=

# Destinataires des contrats (séparés par une virgule) = archive/backup
NOTIFY_EMAIL=contenu@larosiere.net, cm@larosiere.net

# Expéditeur affiché (par défaut = SMTP_USER)
EMAIL_FROM=contenu@larosiere.net
